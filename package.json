{
  "name": "beat-the-beasts-3d",
  "author": "Comfortable Cave Interactive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "playwright test -c tools/shots/playwright.config.ts",
    "extract": "node --experimental-strip-types tools/extract/extract-legacy.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run extract -- --check && npm run validate-data -- --check && node --experimental-strip-types tools/ratings/merge-baselines.ts --check && node tools/run-ts.mjs tools/ratings/build.ts --check && node tools/run-ts.mjs tools/ratings/fit-adapter.ts --check",
    "validate-data": "node --experimental-strip-types tools/reports/validate-data.ts",
    "ratings": "node --experimental-strip-types tools/ratings/merge-baselines.ts && node tools/run-ts.mjs tools/ratings/build.ts && node tools/run-ts.mjs tools/ratings/fit-adapter.ts && node tools/run-ts.mjs tools/ratings/report.ts",
    "augment": "node --experimental-strip-types tools/augment/build.ts",
    "predev": "node tools/run-ts.mjs tools/ratings/build.ts --inputs-only",
    "prebuild": "node tools/run-ts.mjs tools/ratings/build.ts --inputs-only",
    "sim:harness": "node tools/run-ts.mjs tools/sim/harness.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "motion": "^13.4.1",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
